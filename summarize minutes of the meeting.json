    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst summary = String(body.summary ?? 'No summary was provided.');\nconst transcript = String(body.transcript ?? 'No transcript available.');\nconst timestamp = String(body.timestamp ?? '');\n\nconst slackSummary = summary\n  .replace(/^#{1,6}\\s+(.+)$/gm, '*$1*')\n  .replace(/\\*\\*(.+?)\\*\\*/g, '*$1*');\n\nconst processedLine = timestamp ? `\\n_Processed: ${timestamp}_` : '';\n\nreturn [{\n  json: {\n    summary,\n    transcript,\n    timestamp,\n    slackMessage: `*Meeting Notes*${processedLine}\\n\\n*Summary:*\\n${slackSummary}\\n\\n*Transcript:*\\n_${transcript}_`,\n  },\n}];"
      },
      "id": "85f043cd-d596-4557-886e-0db008399793",
